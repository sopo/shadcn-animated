{
  "name": "shadcn-animated",
  "version": "0.1.0",
  "description": "A shadcn-style CLI for animated, copy-friendly UI components.",
  "keywords": [
    "shadcn",
    "react",
    "components",
    "animation",
    "cli"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.9.0"
  },
  "files": [
    "bin",
    "dist",
    "src/components"
  ],
  "bin": {
    "shadcn-animated": "./bin/shadcn-animated.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox.d.ts",
      "import": "./dist/checkbox.js"
    },
    "./select": {
      "types": "./dist/select.d.ts",
      "import": "./dist/select.js"
    },
    "./sheet": {
      "types": "./dist/sheet.d.ts",
      "import": "./dist/sheet.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "import": "./dist/tabs.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm build && pnpm test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@clack/prompts": "^0.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^14.0.3",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  }
}
