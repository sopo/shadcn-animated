{
  "name": "shadcn-animated-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm --filter docs dev",
    "build": "pnpm --filter docs build",
    "lint": "eslint .",
    "release": "pnpm --filter shadcn-animated release",
    "release:patch": "pnpm --filter shadcn-animated release:patch",
    "release:minor": "pnpm --filter shadcn-animated release:minor",
    "release:major": "pnpm --filter shadcn-animated release:major",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "shadcn": "^4.18.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "prism-react-renderer": "^2.4.1",
    "react-code-block": "^1.1.3"
  }
}
